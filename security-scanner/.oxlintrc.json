{
  "plugins": ["node", "promise", "eslint", "unicorn", "oxc", "import"],
  "env": { "browser": false, "node": true },
  "rules": {
    "eslint/no-console": "error",
    "eslint/no-empty": "error",
    "eslint/no-undef": "error"
  },
  "overrides": [
    {
      "files": ["src/index.mjs", "test/*.test.mjs"],
      "rules": { "eslint/no-console": "off" }
    }
  ]
}
